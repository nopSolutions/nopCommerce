@model CountryModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Configuration.Countries.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Countries");
}

<form asp-controller="Country" asp-action="Create" method="post" id="country-form">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1 class="text-body m-0 fs-3">
                @T("Admin.Configuration.Countries.AddNew")
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Configuration.Countries.BackToList")
                    </a>
                </small>
            </h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.CountryDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>