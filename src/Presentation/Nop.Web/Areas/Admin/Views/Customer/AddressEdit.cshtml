@model CustomerAddressModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Customers.Customers.Addresses.EditAddress").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Customers list");
}

<form asp-controller="Customer" asp-action="AddressEdit" method="post">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Customers.Customers.Addresses.EditAddress") 
                <small>
                    <a asp-action="Edit" asp-route-id="@Model.CustomerId">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Customers.Customers.Addresses.BackToCustomer")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.CustomerAddressDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateAddress", Model)
</form>