@model ShippingMethodModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Configuration.Shipping.Methods.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Shipping providers");
}

<form asp-controller="Shipping" asp-action="CreateMethod" method="post">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1 class="text-body m-0 fs-3">
                @T("Admin.Configuration.Shipping.Methods.AddNew") 
                <small>
                    <a asp-action="Methods">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Configuration.Shipping.Methods.BackToList")
                    </a>
                </small>
            </h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ShippingMethodDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateMethod", Model)
</form>