@model NopCommerceNewsModel

@{
    const string cardId = "nopcommerce-news-box";
    const string hideCardAttributeName = "HideNopCommerceNewsCard";
    var hideCard = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCardAttributeName);
    var preferenceUrl = Url.Action("SavePreference", "Preferences");
}

<div class="card card-primary card-outline @(hideCard ? "collapsed-card" : "")" id="@cardId">
    <div class="card-header clearfix">
        <div class="card-title">
            <i class="bi bi-newspaper"></i>
            @T("Admin.NopCommerceNews")

            @if (Model.HasNewItems)
            {
                <span class="new-item-notification"><span>+1</span></span>
            }
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-4">
                    <div class="card card-info">
                        <div class="card-header clearfix">
                            <div class="card-title">
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <a href="@item.Url">@item.Title</a>
                                }
                                else
                                {
                                    @item.Title
                                }
                            </div>
                            @*<div class="app-content-header-actions">@item.PublishDate.ToString("d")</div>*@
                        </div>
                        <div class="card-body">
                            @Html.Raw(item.Summary)
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    $(function() {
        $('#@cardId').on('click', 'button[data-lte-toggle="card-collapse"]', function() {
            var collapsed = !$('#@cardId').hasClass('collapsed-card');
            saveUserPreferences('@preferenceUrl', '@hideCardAttributeName', collapsed);
        });
    });
</script>