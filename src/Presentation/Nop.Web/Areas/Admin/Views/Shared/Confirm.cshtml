@model ActionConfirmationModel

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">            
            <h4 class="modal-title" id="@(Model.WindowId)-title">@T("Admin.Common.AreYouSure")</h4>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            @if (!string.IsNullOrEmpty(Model.AdditonalConfirmText))
            {
                <div class="additional-text">
                    @T(Model.AdditonalConfirmText)
                </div>
            }
            @T("Admin.Common.ActionConfirmation")
        </div>
        <div class="modal-footer">
            <button type="button" id="@(Model.WindowId)-submit-button" class="btn btn-primary float-right">
                @T("Admin.Common.Yes")
            </button>
            <button type="button" class="btn btn-default float-right margin-r-5" data-bs-dismiss="modal">@T("Admin.Common.NoCancel")</button>
        </div>
    </div>
</div>

<script>
    $(function(){
        const openerBtn = document.getElementById('@Model.ButtonId');

        if (openerBtn) {
            openerBtn.type = "button";
            openerBtn.setAttribute("data-bs-toggle", "modal");
            openerBtn.setAttribute("data-bs-target", "#@Model.WindowId")

            $('#@(Model.WindowId)-submit-button').on('click', function() {
                if (!openerBtn.name)
                    return;

                openerBtn.type = "submit";
                openerBtn.click();
            });
        }
    });
</script>