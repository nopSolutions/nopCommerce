@model CustomerAttributeModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Customers.CustomerAttributes.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Customer and user settings");
}

<form asp-controller="CustomerAttribute" asp-action="Create" method="post" id="customerattribute-form">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Customers.CustomerAttributes.AddNew") 
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Customers.CustomerAttributes.BackToList")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.CustomerAttributeDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>