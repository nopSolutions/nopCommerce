@model ProductAttributeModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Catalog.Attributes.ProductAttributes.EditAttributeDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Product attributes");
}

<form asp-controller="ProductAttribute" asp-action="Edit" method="post" id="productattribute-form">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Catalog.Attributes.ProductAttributes.EditAttributeDetails") - @Model.Name
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Catalog.Attributes.ProductAttributes.BackToList")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                @if (Model.PreTranslationAvailable)
                {
                    @await Html.PartialAsync("_PreTranslateButton", "PreTranslate")
                }
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                <span id="productattribute-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    @T("Admin.Common.Delete")
                </span>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ProductAttributeDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="productattribute-delete" />