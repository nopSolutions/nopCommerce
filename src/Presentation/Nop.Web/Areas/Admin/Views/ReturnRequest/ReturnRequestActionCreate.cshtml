@model ReturnRequestActionModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Configuration.Settings.Order.ReturnRequestActions.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Order settings");
}

<form asp-controller="ReturnRequest" asp-action="ReturnRequestActionCreate" method="post">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Configuration.Settings.Order.ReturnRequestActions.AddNew")
                <small>
                    <a asp-action="ReturnRequestActionList">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Configuration.Settings.Order.ReturnRequestActions.BackToList")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ReturnRequestActionDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>

    <section class="app-content">
        <div class="container-fluid">
            <div class="form-horizontal">
                @await Html.PartialAsync("_CreateOrUpdate.ReturnRequestAction", Model)
            </div>
        </div>
    </section>
</form>