@model GiftCardModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.GiftCards.EditGiftCardDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Gift cards");
}

<form asp-controller="GiftCard" asp-action="Edit" method="post">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1 class="text-body m-0 fs-3">
                @T("Admin.GiftCards.EditGiftCardDetails")
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.GiftCards.BackToList")
                    </a>
                </small>
            </h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                <span id="giftcard-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    @T("Admin.Common.Delete")
                </span>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.GiftCardDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="giftcard-delete" />
