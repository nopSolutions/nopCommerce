@model AffiliateCommissionEditModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Affiliates.Commission.Edit").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Affiliates");
}

<form asp-controller="Affiliate" asp-action="EditCommission" method="post" id="commission-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Affiliates.Commission.Edit") - @Model.Id
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Edit" asp-route-id="@Model.AffiliateId">@T("Admin.Affiliates.Commission.CreateOrUpdate.BackToAffiliate")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            @if (!Model.PaidOn.HasValue)
            {
                <button type="submit" name="mark_as_paid" class="btn btn-secondary">
                    <i class="fas fa-coins"></i>
                    @T("Admin.Affiliates.Orders.MarkPaid")
                </button>
                <span id="commission-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    @T("Admin.Common.Delete")
                </span>
            }
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.AffiliateCommissionDetailsButtons, additionalData = Model })
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateCommission", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="commission-delete" asp-action="DeleteCommission" />