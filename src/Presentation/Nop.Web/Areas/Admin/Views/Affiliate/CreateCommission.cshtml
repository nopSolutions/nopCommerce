@model AffiliateCommissionEditModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Affiliates.Commission.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Affiliates");
}

<form asp-controller="Affiliate" asp-action="CreateCommission" method="post" id="commission-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Affiliates.Commission.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Edit" asp-route-id="@Model.AffiliateId">@T("Admin.Affiliates.Commission.CreateOrUpdate.BackToAffiliate")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.AffiliateCommissionDetailsButtons, additionalData = Model })
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateCommission", Model)
</form>