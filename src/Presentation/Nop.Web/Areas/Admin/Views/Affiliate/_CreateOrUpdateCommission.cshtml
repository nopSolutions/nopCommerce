@model AffiliateCommissionEditModel

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="AdminComment" />
                        </div>
                        <div class="col-md-9">
                            <nop-textarea asp-for="AdminComment"></nop-textarea>
                            <span asp-validation-for="AdminComment"></span>
                        </div>
                    </div>
                    <input type="hidden" asp-for="AffiliateId" />
                    @if (Model.Id != 0)
                    {
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="TotalCommissionAmount" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row" id="totalCommissionAmount">@Model.TotalCommissionAmount</div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CreateOn" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.CreateOn</div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CommissionStatus" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.CommissionStatus</div>
                            </div>
                        </div>
                        if (Model.PaidOn.HasValue)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="PaidOn" />
                                </div>
                                <div class="col-md-9">
                                    <div class="form-text-row">@Model.PaidOn</div>
                                </div>
                            </div>
                        }
                    }

                    @if (Model.Id > 0)
                    {
                        <div class="card">
                            <div class="card-header">@T("Admin.Affiliates.Commission.CreateOrUpdate.IncludedOrders")</div>
                            <div class="card-body">
                                @await Html.PartialAsync("Table", new DataTablesModel
                                {
                                    Name = "added-orders-grid",
                                    UrlRead = new DataUrl("AffiliatedOrderListGrid", "Affiliate", new RouteValueDictionary
                                    {
                                        [nameof(AffiliatedOrderSearchModel.AffiliateId)] = Model.AffiliateId,
                                        [nameof(AffiliatedOrderSearchModel.IsCommissionPage)] = true,
                                        [nameof(AffiliatedOrderSearchModel.AffiliateCommissionId)] = Model.Id
                                    }),
                                    Length = int.MaxValue,
                                    ColumnCollection = new List<ColumnProperty>
                                    {
                                        new(nameof(AffiliatedOrderModel.CustomOrderNumber))
                                        {
                                            Title = T("Admin.Affiliates.Orders.CustomOrderNumber").Text
                                        },
                                        new(nameof(AffiliatedOrderModel.OrderStatus))
                                        {
                                            Title = T("Admin.Affiliates.Orders.OrderStatus").Text,
                                            Render = new RenderCustom("renderOrderStatus")
                                        },
                                        new(nameof(AffiliatedOrderModel.PaymentStatus))
                                        {
                                            Title = T("Admin.Affiliates.Orders.PaymentStatus").Text
                                        },
                                        new(nameof(AffiliatedOrderModel.ShippingStatus))
                                        {
                                            Title = T("Admin.Affiliates.Orders.ShippingStatus").Text
                                        },
                                        new(nameof(AffiliatedOrderModel.OrderTotal))
                                        {
                                            Title = T("Admin.Affiliates.Orders.OrderTotal").Text
                                        },
                                        new(nameof(AffiliatedOrderModel.CreatedOn))
                                        {
                                            Title = T("Admin.Affiliates.Orders.CreatedOn").Text,
                                            Render = new RenderDate()
                                        },
                                        new(nameof(AffiliatedOrderModel.AffiliateCommission))
                                        {
                                            Title = T("Admin.Affiliates.Orders.AffiliateCommission").Text,
                                        },
                                        new(nameof(AffiliatedOrderModel.Id))
                                        {
                                            Title = T("Admin.Common.View").Text,
                                            Width = "100",
                                            ClassName = NopColumnClassDefaults.Button,
                                            Render = new RenderButtonView(new DataUrl("~/Admin/Order/Edit/", nameof(AffiliatedOrderModel.Id)))
                                        },
                                        new(nameof(AffiliatedOrderModel.Id))
                                        {
                                            Title = T("Admin.Affiliates.Commission.RemoveOrderFromCommission").Text,
                                            Width = "100",
                                            Render = new RenderCustom("renderRemoveOrder"),
                                            Visible = !Model.PaidOn.HasValue
                                        }
                                    }
                                })
                            </div>
                            
                            <div class="card-footer">
                                @if (Model.Id == 0)
                                {
                                    <span>@T("Admin.Affiliates.Commission.SaveForEdit")</span>
                                }
                                else if (!Model.PaidOn.HasValue)
                                {
                                    <button id="btnRefresh" type="submit" name="save" class="btn btn-default" style="display: none"></button>
                                    <button type="submit" onclick="javascript:OpenWindow('@(Url.Action("AddOrdersToAffiliateCommissionPopup", new { id = Model.Id, affiliateId = Model.AffiliateId, btnId = "btnRefresh" }))', 800, 850, true); return false;" class="btn btn-primary">
                                        @T("Admin.Affiliates.Commission.SelectOrders")
                                    </button>

                                    <script>
                                        $(function() {
                                            $('#btnRefresh').click(function () {
                                                //refresh grid
                                                updateTable('#added-orders-grid');

                                                //return false to don't reload a page
                                                return false;
                                            });
                                        });
                                    </script>
                                }
                            </div>

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

<nop-alert asp-alert-id="nothingSelectedAlert" />

<script>
    function renderOrderStatus(data, type, row, meta) {

        var color;
        switch (row.OrderStatusId) {
            case 10: color = 'yellow'; break;
            case 20: color = 'blue'; break;
            case 30: color = 'green'; break;
            case 40: color = 'red'; break;
        }

        return '<span class="grid-report-item ' + color + '">' + data + '</span >';
    }

    function renderRemoveOrder(data, type, row, meta) {
        return '<a class="btn btn-danger" href="#" onclick="removeOrder(' + row.Id + '); return false;"><i class="fas fa-trash"></i> ' + '@T("Admin.Affiliates.Commission.RemoveOrderFromCommission")' + '</a>';
    }

    function removeOrder(orderId) {
        var postData = {
            orderId: orderId,
            affiliateCommissionId: @Model.Id
        };
        addAntiForgeryToken(postData);
        $.ajax({
            cache: false,
            type: 'POST',
            url: '@(Url.Action("RemoveOrderFromCommission", "Affiliate"))',
            data: postData,
            success: function (data, textStatus, jqXHR) {
                if (data && data.Result) {
                    $('#totalCommissionAmount').text(data.totalCommissionAmount);
                }
            },
            complete: function (jqXHR, textStatus) {
                updateTable('#orders-grid');
                updateTable('#added-orders-grid');
            }
        });
    }

</script>