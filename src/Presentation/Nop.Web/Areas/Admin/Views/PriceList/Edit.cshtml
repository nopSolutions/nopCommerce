@model PriceListModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Catalog.PriceLists.EditPriceListDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Price lists");
}

<form asp-controller="PriceList" asp-action="Edit" method="post" id="price-list-form">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Catalog.PriceLists.EditPriceListDetails") - @Model.Id
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Catalog.PriceLists.BackToList")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                <span id="price-list-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    @T("Admin.Common.Delete")
                </span>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.PriceListDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="price-list-delete" />