@model AddressAttributeValueModel
@{
    Layout = "_AdminPopupLayout";

    //page title
    ViewBag.PageTitle = T("Admin.Address.AddressAttributes.Values.EditValueDetails").Text;
}
<form asp-controller="AddressAttribute" asp-action="ValueEditPopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]" data-bs-theme="light">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1 class="text-body m-0 fs-3">
                @T("Admin.Address.AddressAttributes.Values.EditValueDetails")
            </h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.AddressAttributeValueDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateValue", Model)
</form>