@model DiscountModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Promotions.Discounts.EditDiscountDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Discounts");
}

<form asp-controller="Discount" asp-action="Edit" method="post" id="discount-form">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Promotions.Discounts.EditDiscountDetails") - @Model.Name
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Admin.Promotions.Discounts.BackToList")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                <span id="discount-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    @T("Admin.Common.Delete")
                </span>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.DiscountDetailsButtons, additionalData = Model })
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="discount-delete" />
