@model ContactFormAttributeValueModel

@{
    Layout = "_AdminPopupLayout";

    //page title
    ViewBag.PageTitle = T("Admin.Common.ContactFormAttributes.Values.EditValueDetails").Text;
}

<form asp-controller="ContactFormAttribute" asp-action="ValueEditPopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]" data-bs-theme="light">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Admin.Common.ContactFormAttributes.Values.EditValueDetails")
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateValue", Model)
</form>