@model ForumModel

@{
    //page title
    ViewBag.PageTitle = T("Plugins.Misc.Forums.Forum.EditForum").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Manage forums");
}

<form asp-controller="Forum" asp-action="EditForum" method="post">
    <div class="app-content-header">
        <div class="container-fluid">
            <h1>
                @T("Plugins.Misc.Forums.Forum.EditForum") - @Model.Name
                <small>
                    <a asp-action="List">
                        <i class="fas fa-arrow-circle-left"></i>
                        @T("Plugins.Misc.Forums.Forum.BackToList")
                    </a>
                </small>
            </h1>
            <div class="app-content-header-actions">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
                <button type="submit" name="save-continue" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.SaveContinue")
                </button>
                <span id="forum-delete" class="btn btn-danger">
                    <i class="far fa-trash-can"></i>
                    @T("Admin.Common.Delete")
                </span>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Forums/Admin/Views/_CreateOrUpdateForum.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="forum-delete" asp-action="DeleteForum"/>
