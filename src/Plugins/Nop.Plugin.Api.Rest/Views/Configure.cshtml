@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<nop-cards id="api-rest">
    <nop-card asp-name="api-rest-swagger" asp-icon="fas fa-file-code" asp-title="@T("Plugin.Api.Rest.Title")"
              asp-hide-block-attribute-name="api-rest-swagger" asp-hide="false" asp-advanced="false">
        <div class="card-body">
            <p>@T("Plugin.Api.Rest.Description")</p>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="SwaggerUiUrl" />
                </div>
                <div class="col-md-9">
                    <a class="btn btn-primary" href="@Model.SwaggerUiUrl" target="_blank" rel="noopener">
                        <i class="fas fa-external-link-alt"></i>
                        &nbsp;@T("Plugin.Api.Rest.OpenSwaggerUi")
                    </a>
                    <a href="@Model.SwaggerUiUrl">@Model.SwaggerUiUrl</a>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="SwaggerJsonUrl" />
                </div>
                <div class="col-md-9">
                    <a class="btn btn-primary" href="@Model.SwaggerJsonUrl" target="_blank" rel="noopener">
                        <i class="fas fa-file-code"></i>
                        &nbsp;@T("Plugin.Api.Rest.OpenSwaggerJson")
                    </a>
                    <a href="@Model.SwaggerJsonUrl">@Model.SwaggerJsonUrl</a>
                </div>
            </div>
        </div>
    </nop-card>
</nop-cards>
