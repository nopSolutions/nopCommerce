{
  "info": {
    "name": "Nop.Plugin.Api.Rest - Sample",
    "_postman_id": "nop-plugin-api-rest-sample",
    "description": "Sample requests for Nop.Plugin.Api.Rest. List endpoints return { items, pageIndex, pageSize, totalCount, totalPages }. pageIndex is zero based, pageSize capped at 200. Two credentials: api_key (admin level) and customer_token (one customer's own data).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
