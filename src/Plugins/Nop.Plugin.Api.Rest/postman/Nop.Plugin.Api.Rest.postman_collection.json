      "name": "Get API key (admin)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your_password\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/rest/token", "host": ["{{base_url}}"], "path": ["api","rest","token"] }
      }
    },
    {
      "name": "Get customer token",
