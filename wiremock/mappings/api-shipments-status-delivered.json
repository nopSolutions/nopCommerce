{
  "scenarioName": "shipment-lifecycle",
  "requiredScenarioState": "delivered",
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/shipments/([^/]+)/status"
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "externalShipmentId": "{{request.pathSegments.[2]}}",
      "status": "DELIVERED",
      "occurredAtUtc": "{{now}}"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
