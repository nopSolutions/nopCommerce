@model string
@inject AdminAreaSettings adminAreaSettings
@inject ISummernoteHelper summernoteHelper

@using Nop.Web.Areas.Admin.Helpers
@{
    // Summernote language
    var language = await summernoteHelper.GetRichEditorLanguageAsync();

    var random = CommonHelper.GenerateRandomInteger();

    var allowElFinder = await permissionService.AuthorizeAsync(StandardPermission.System.HTML_EDITOR_MANAGE_PICTURES);

    //extend editor with additional settings
    var additionalEditorSettings = adminAreaSettings.RichEditorAdditionalSettings;

    //is java-script supported?
    var allowJavaScript = adminAreaSettings.RichEditorAllowJavaScript;

    // Url connector
    var connectorUrl = Url.Action("Connector", "ElFinder");
}
<script src="~/lib_npm/summernote/summernote-bs4.min.js" asp-location="Head"></script>
<script src="~/lib_npm/elfinder/js/elfinder.min.js" asp-location="Head"></script>
<script src="~/lib/summernote/summernote-image-attributes.js" asp-location="Head"></script>
<script src="~/lib/summernote/summernote-link-browse.js" asp-location="Head"></script>

<link href="~/lib_npm/summernote/summernote-bs4.min.css" rel="stylesheet" />
<link href="~/lib_npm/elfinder/css/elfinder.min.css" rel="stylesheet" />
<link href="~/lib_npm/elfinder/css/theme.css" rel="stylesheet" />
<link href="~/lib/summernote/summernote-link-button.css" rel="stylesheet" />

@if (!string.IsNullOrEmpty(language))
{
    <script src="~/lib_npm/summernote/lang/summernote-@(language).min.js" asp-location="Head"></script>
}

<script asp-location="Head">
    const ELFINDER_COMMANDS = elFinder.prototype._options.commands;
    const ELFINDER_TOOLBAR = [
        ['back', 'forward'],
        ['reload'],
        ['home', 'up'],
        ['mkdir', 'upload'],
        ['open', 'download'],
        ['undo', 'redo'],
        ['info'],
        ['quicklook'],
        ['copy', 'cut', 'paste'],
        ['rm'],
        ['duplicate', 'rename', 'edit'],
        ['selectall', 'selectnone', 'selectinvert'],
        ['view', 'sort'],
        ['search']
    ];

    // ElFinder dialog for link browse button
    function openElFinderDialogForLink(fileSelectedCallback) {
        $('<div/>').dialogelfinder({
            url: '@connectorUrl',
            lang: '@language',
            destroyOnClose: true,
            getFileCallback: function(files, fm) {
                // If we have a callback from the link dialog button, use it
                if (fileSelectedCallback && typeof fileSelectedCallback === 'function') {
                    fileSelectedCallback(files);
                }
            },
            commandsOptions: {
                getfile: {
                    oncomplete: 'close',
                    folders: false
                }
            },
            resizable: false,
            commands: ELFINDER_COMMANDS,
            uiOptions: {
                toolbar: ELFINDER_TOOLBAR
            }
        }).dialogelfinder('instance');
    };

    $(function () {
        // Summernote - Image insertion via elFinder
        function openElFinderDialog() {
            $('<div/>').dialogelfinder({
                url: '@connectorUrl',
                lang: '@language',
                destroyOnClose : true,
                getFileCallback : function(files, fm) {
                    $('#@Html.IdForModel()').summernote('editor.insertImage',files.url);
                },
                commandsOptions : {
                    getfile : {
                        oncomplete : 'close',
                        folders : false
                    }
                },
                resizable: false,
                commands: ELFINDER_COMMANDS,
                uiOptions: {
                    toolbar: ELFINDER_TOOLBAR
                }
            }).dialogelfinder('instance');
        }

        //Image button for elFinder
        var ElFinderImageButton = function () {
            var ui = $.summernote.ui;

            // create button
            return ui.button({
                contents: '<i class="fa fa-image"/>',
                tooltip: 'Insert image',
                click: function () {
                    openElFinderDialog();
                }
            }).render();
        };

        var initializationOptions@(random) = {
            @if (allowJavaScript)
            {
                <text>
                    codeviewFilter: false,
                </text>
            }
            toolbar: [
                ['view', ['undo', 'redo']],
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['fontname', ['fontname']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'elfinder', 'video', 'hr']],
                ['view', ['fullscreen', 'codeview', 'help']]
            ],
            fontSizes: ['8','9','10','11','12','14','16','18','24','36'],
            buttons: {
                @if (allowElFinder)
                {
                    <text>
                        elfinder: ElFinderImageButton,
                    </text>
                }
            },
            popover: {
                image: [
                    ['custom', ['imageAttributes']],
                    ['float', ['floatLeft', 'floatRight', 'floatNone']],
                    ['remove', ['removeMedia']]
                ],
            },
            imageAttributes:{
                icon: '<i class="note-icon-pencil"/>',
                removeEmpty: true,
                disableUpload: true
            },
            spellCheck: true,
            maxHeight: 800,
            callbacks: {
                onBlurCodeview: function(code) {
                    // Sync CodeView content when switching back to normal view
                    $(this).summernote('code', $(this).summernote('code'));
                }
            },
            @if (!string.IsNullOrEmpty(language))
            {
                <text>
                    lang: '@language',
                </text>
            }
        };

    function getAdditionalEditorSettings@(random)(settings) {
        @Html.Raw(additionalEditorSettings)
        return settings;
    }

    $('#@Html.IdForModel()').summernote(getAdditionalEditorSettings@(random)(initializationOptions@(random)));
    });
</script>

<textarea class="summernote" asp-for="@Model">@ViewData.TemplateInfo.FormattedModelValue</textarea>
<nop-alert asp-alert-id="createConfigurationFailed" />